# Copy to .env and edit. Every setting is optional; defaults work on a laptop.

# --- Core
# DATABASE_URL=sqlite:///rolescout.db            # Postgres: postgresql+psycopg://user:pass@host/db
# ROLESCOUT_SECRET_KEY=change-me-to-a-long-random-string   # required in production
# ROLESCOUT_BASE_URL=http://localhost:8000
# ROLESCOUT_ADMIN_EMAILS=you@example.com           # these emails become admins at signup
# ROLESCOUT_SIGNUPS_OPEN=true

# --- Bulk extraction tier: heuristic | local | anthropic
# Your own machine, free per call (Ollama / LM Studio / llama.cpp):
# ROLESCOUT_EXTRACTOR=local
# ROLESCOUT_EXTRACTOR_MODEL=qwen2.5:7b-instruct
# ROLESCOUT_LOCAL_LLM_BASE_URL=http://localhost:11434/v1     # LM Studio: http://localhost:1234/v1
# Hosted (production), Claude API:
# ROLESCOUT_EXTRACTOR=anthropic
# ROLESCOUT_EXTRACTOR_MODEL=claude-haiku-4-5

# --- Verification tier: none | anthropic | local
# ROLESCOUT_VERIFIER=anthropic
# ROLESCOUT_VERIFIER_MODEL=claude-sonnet-5-5
# ROLESCOUT_VERIFY_SAMPLE_RATE=0.05              # random QA sample on top of disagreements
# ROLESCOUT_VERIFY_CONFIDENCE_BELOW=0.7
# ANTHROPIC_API_KEY=sk-ant-...                  # or run `ant auth login`

# --- Scheduling (inside `rolescout serve`); 0 = off, run `rolescout run` from cron instead
# ROLESCOUT_SCHEDULE_MINUTES=180

# --- Workday tuning
# ROLESCOUT_WORKDAY_SEARCH_TEXT=engineer         # narrow huge Workday boards to engineering
# ROLESCOUT_WORKDAY_MAX_JOBS=2000

# --- Email digests. Without SMTP_HOST, digests are saved as HTML files in ./outbox
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=RoleScout <digest@yourdomain.com>
